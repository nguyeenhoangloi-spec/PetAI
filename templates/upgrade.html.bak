            <a href="{{ url_for('legal.payment_policy') }}" class="hover:text-primary dark:hover:text-blue-400 transition-colors font-medium" data-i18n="policyLink">ChÃƒÂ­nh sÃƒÂ¡ch thanh toÃƒÂ¡n</a>
            <span class="text-slate-800">Ã¢â‚¬Â¢</span>
            <a href="{{ url_for('legal.terms_of_service') }}" class="hover:text-primary dark:hover:text-blue-400 transition-colors font-medium" data-i18n="termsLink">Ã„ÂiÃ¡Â»Âu khoÃ¡ÂºÂ£n sÃ¡Â»Â­ dÃ¡Â»Â¥ng</a>
          </div>
        </footer>
      </div>
    </main>

<script>
  (function () {
    // --- FAQ Accordion ---
    window.toggleFaq = function (btn) {
      const faqItem = btn.parentElement;
      const answer = faqItem.querySelector(".faq-ans");
      const icon = btn.querySelector(".material-symbols-outlined");
      
      // Close other accordions
      document.querySelectorAll(".faq-ans").forEach((el) => {
        if (el !== answer) {
          el.style.maxHeight = null;
          const otherBtn = el.parentElement.querySelector("button");
          if (otherBtn) {
            const otherIcon = otherBtn.querySelector(".material-symbols-outlined");
            if (otherIcon) otherIcon.style.transform = "rotate(0deg)";
          }
        }
      });

      if (answer.style.maxHeight) {
        answer.style.maxHeight = null;
        if (icon) icon.style.transform = "rotate(0deg)";
      } else {
        answer.style.maxHeight = answer.scrollHeight + "px";
        if (icon) icon.style.transform = "rotate(180deg)";
      }
    };
 
    // --- Collapsible Modal FAQ section toggle ---
    window.toggleModalFaqSection = function () {
      const content = document.getElementById("modalFaqContent");
      const chevron = document.getElementById("modalFaqChevron");
      if (!content || !chevron) return;
      if (content.classList.contains("max-h-0")) {
        content.classList.remove("max-h-0");
        content.classList.add("max-h-[1000px]");
        chevron.style.transform = "rotate(180deg)";
      } else {
        content.classList.remove("max-h-[1000px]");
        content.classList.add("max-h-0");
        chevron.style.transform = "rotate(0deg)";
      }
    };

    // --- Collapsible Modal Bank Credentials section toggle ---
    window.toggleModalBankSection = function () {
      const content = document.getElementById("modalBankContent");
      const chevron = document.getElementById("modalBankChevron");
      if (!content || !chevron) return;
      if (content.classList.contains("max-h-0")) {
        content.classList.remove("max-h-0");
        content.classList.add("max-h-[1000px]");
        chevron.style.transform = "rotate(180deg)";
      } else {
        content.classList.remove("max-h-[1000px]");
        content.classList.add("max-h-0");
        chevron.style.transform = "rotate(0deg)";
      }
    };

    // --- Copy Clipboard Helper ---
    window.copyText = function (elementId) {
      const el = document.getElementById(elementId);
      if (!el) return;
      const text = el.innerText || el.textContent;
      
      navigator.clipboard.writeText(text.trim()).then(() => {
        if (typeof window.showToast === "function") {
          const isEn = (document.documentElement.getAttribute("data-user-lang") === "en");
          window.showToast("success", isEn ? "Copied successfully!" : "Ã„ÂÃƒÂ£ sao chÃƒÂ©p thÃƒÂ nh cÃƒÂ´ng!");
        }
      }).catch(err => {
        console.error("Clipboard copy failed:", err);
      });
    };

    // --- Dynamic Settings / Pricing Syncer ---
    function updateDynamicPrices(lang) {
      const settings = window.PetAI_DynamicSettings ? window.PetAI_DynamicSettings[lang] : null;
      if (!settings) return;

      const cardBasicPrice = document.querySelector("#card-basic .price-display");
      const cardBasicPriceSub = document.querySelector("#card-basic .price-display + p");
      const cardProPrice = document.querySelector("#card-pro .price-display");
      const cardProPriceSub = document.querySelector("#card-pro .price-display + p");
      const cardEnterprisePrice = document.querySelector("#card-enterprise .price-display");
      const cardEnterprisePriceSub = document.querySelector("#card-enterprise .price-display + p");

      if (cardBasicPrice) cardBasicPrice.innerText = settings.planBasicPrice;
      if (cardBasicPriceSub) cardBasicPriceSub.innerText = settings.planBasicPriceSub;
      if (cardProPrice) cardProPrice.innerText = settings.planProPrice;
      if (cardProPriceSub) cardProPriceSub.innerText = settings.planProPriceSub;
      if (cardEnterprisePrice) cardEnterprisePrice.innerText = settings.planEntPrice;
      if (cardEnterprisePriceSub) cardEnterprisePriceSub.innerText = settings.planEntPriceSub;

      // Card feature scan limit updates
      const basicLimit = document.querySelector("#card-basic [data-i18n='scanLimit50']");
      if (basicLimit) basicLimit.innerText = settings.scanLimit50;

      const proLimit = document.querySelector("#card-pro [data-i18n='scanLimit200']");
      if (proLimit) proLimit.innerText = settings.scanLimit200;

      const entLimit = document.querySelector("#card-enterprise [data-i18n='scanLimitUnlimit']");
      if (entLimit) entLimit.innerText = settings.scanLimitUnlimit;
    }

    // --- Interactive Checkout Modal Block ---
    let checkoutModal = null;
    let checkoutModalContent = null;
    let checkoutPlanIcon = null;
    let checkoutPlanName = null;
    let checkoutPlanPrice = null;
    let checkoutPlanDuration = null;
    
    let checkoutBankVal = null;
    let checkoutAccountVal = null;
    let checkoutHolderVal = null;
    let checkoutAmountVal = null;
    let checkoutAmountRawVal = null;
    let checkoutMemoVal = null;
    
    let checkoutQrImg = null;
    let checkoutQrLoader = null;
    let confirmOrderId = null;

    let activeSelectedPlan = null;
    let statusCheckingInterval = null;

    // Reset card highlight borders
    function resetCardHighlights() {
      document.querySelectorAll(".pricing-card").forEach(card => {
        card.classList.remove("ring-4", "ring-primary", "dark:ring-blue-500", "scale-[1.01]");
      });
    }

    // Scroll lock helpers Ã¢â‚¬â€ zero layout shift technique
    let _scrollLockY = 0;
    function lockScroll() {
      _scrollLockY = window.scrollY;
      document.body.style.position = "fixed";
      document.body.style.top = "-" + _scrollLockY + "px";
      document.body.style.left = "0";
      document.body.style.right = "0";
      document.body.style.width = "100%";
    }
    function unlockScroll() {
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.left = "";
      document.body.style.right = "";
      document.body.style.width = "";
      window.scrollTo(0, _scrollLockY);
    }

    // Open checkout modal
    function showCheckoutModal() {
      if (!checkoutModal) return;
      checkoutModal.classList.remove("hidden");
      checkoutModal.classList.add("flex");
      lockScroll();

      // Reset collapsed accordion sections to closed by default
      const bankContent = document.getElementById("modalBankContent");
      const bankChevron = document.getElementById("modalBankChevron");
      if (bankContent && bankChevron) {
        bankContent.classList.remove("max-h-[1000px]");
        bankContent.classList.add("max-h-0");
        bankChevron.style.transform = "rotate(0deg)";
      }
      const faqContent = document.getElementById("modalFaqContent");
      const faqChevron = document.getElementById("modalFaqChevron");
      if (faqContent && faqChevron) {
        faqContent.classList.remove("max-h-[1000px]");
        faqContent.classList.add("max-h-0");
        faqChevron.style.transform = "rotate(0deg)";
      }

      // Trigger animations
      setTimeout(() => {
        checkoutModal.classList.remove("opacity-0");
        if (checkoutModalContent) {
          checkoutModalContent.classList.remove("scale-95");
          checkoutModalContent.classList.add("scale-100");
        }
      }, 10);
    }

    // Hide checkout card (close modal)
    function hideCheckout() {
      if (checkoutModal) {
        checkoutModal.classList.add("opacity-0");
        if (checkoutModalContent) {
          checkoutModalContent.classList.remove("scale-100");
          checkoutModalContent.classList.add("scale-95");
        }
        setTimeout(() => {
          checkoutModal.classList.add("hidden");
          checkoutModal.classList.remove("flex");
          unlockScroll();
        }, 300);
      }
      resetCardHighlights();
      activeSelectedPlan = null;
      if (statusCheckingInterval) {
        clearInterval(statusCheckingInterval);
        statusCheckingInterval = null;
      }
    }
    window.closeCheckoutModal = hideCheckout;

    // --- Fullscreen QR Modal functions ---
    window.openQrFullscreen = function () {
      const qrImg = document.getElementById("checkout-qr-img");
      const fullscreenModal = document.getElementById("qrFullscreenModal");
      const fullscreenQrImg = document.getElementById("fullscreen-qr-img");
      if (!qrImg || !fullscreenModal || !fullscreenQrImg) return;
      
      fullscreenQrImg.src = qrImg.src;
      fullscreenModal.classList.remove("hidden");
      fullscreenModal.classList.add("flex");
      
      setTimeout(() => {
        fullscreenModal.classList.remove("opacity-0");
        const modalContent = fullscreenModal.querySelector("div");
        if (modalContent) {
          modalContent.classList.remove("scale-95");
          modalContent.classList.add("scale-100");
        }
      }, 10);
    };

    window.closeQrFullscreen = function () {
      const fullscreenModal = document.getElementById("qrFullscreenModal");
      if (!fullscreenModal) return;
      
      fullscreenModal.classList.add("opacity-0");
      const modalContent = fullscreenModal.querySelector("div");
      if (modalContent) {
        modalContent.classList.remove("scale-100");
        modalContent.classList.add("scale-95");
      }
      
      setTimeout(() => {
        fullscreenModal.classList.add("hidden");
        fullscreenModal.classList.remove("flex");
      }, 300);
    };

    // Highlight selected card
    function highlightPlanCard(plan) {
      resetCardHighlights();
      const card = document.getElementById(`card-${plan}`);
      if (card) {
        card.classList.add("ring-4", "ring-primary", "dark:ring-blue-500", "scale-[1.01]");
      }
    }

    // Stop and clean checking interval
    function stopStatusChecking() {
      if (statusCheckingInterval) {
        clearInterval(statusCheckingInterval);
        statusCheckingInterval = null;
      }
    }

    // Poll check invoice status
    function startStatusChecking(orderId) {
      stopStatusChecking();
      statusCheckingInterval = setInterval(async () => {
        try {
          const res = await fetch(`/predict/payments/status?order_id=${orderId}`, {
            headers: {
              "X-Requested-With": "XMLHttpRequest"
            }
          });
          if (res.ok) {
            const data = await res.json();
            if (data && data.success && data.status === "paid") {
              stopStatusChecking();
              if (typeof window.showToast === "function") {
                const lang = document.documentElement.getAttribute("data-user-lang") || "vi";
                const msg = lang === "en" ? "Payment received! Activating plan..." : "Ã„ÂÃƒÂ£ nhÃ¡ÂºÂ­n thanh toÃƒÂ¡n! Ã„Âang kÃƒÂ­ch hoÃ¡ÂºÂ¡t gÃƒÂ³i...";
                window.showToast("success", msg);
              }
              setTimeout(() => {
                if (window.loadPagePjax) {
                  window.loadPagePjax("{{ url_for('predict.my_payments') }}");
                } else {
                  window.location.href = "{{ url_for('predict.my_payments') }}";
                }
              }, 1500);
            }
          }
        } catch (e) {
          console.error("Error polling payment status:", e);
        }
      }, 4000);
    }

    // Load checkout payment info
    async function selectPlanAndShowCheckout(plan) {
      activeSelectedPlan = plan;
      highlightPlanCard(plan);

      // Reset loading states
      if (checkoutQrLoader) checkoutQrLoader.style.display = "flex";
      
      showCheckoutModal();

      // Update package summary values instantly
      const lang = document.documentElement.getAttribute("data-user-lang") || "vi";
      const settings = window.PetAI_DynamicSettings ? window.PetAI_DynamicSettings[lang] : null;
      if (settings) {
        if (plan === "basic") {
          checkoutPlanIcon.innerText = "bolt";
          checkoutPlanName.innerText = settings.planBasicName;
          checkoutPlanPrice.innerText = settings.planBasicPrice;
          checkoutPlanDuration.innerText = "/ " + settings.planBasicDuration;
        } else if (plan === "pro") {
          checkoutPlanIcon.innerText = "workspace_premium";
          checkoutPlanName.innerText = settings.planProName;
          checkoutPlanPrice.innerText = settings.planProPrice;
          checkoutPlanDuration.innerText = "/ " + settings.planProDuration;
        } else if (plan === "enterprise") {
          checkoutPlanIcon.innerText = "crown";
          checkoutPlanName.innerText = settings.planEntName;
          checkoutPlanPrice.innerText = settings.planEntPrice;
          checkoutPlanDuration.innerText = "/ " + settings.planEntDuration;
        }
      }

      // Call checkout order generation
      try {
        const formData = new FormData();
        formData.append("plan", plan);
        formData.append("payment_method", "qr");
        
        const csrfToken = document.querySelector('meta[name="csrf-token"]');
        if (csrfToken) {
          formData.append("csrf_token", csrfToken.getAttribute("content"));
        }

        const res = await fetch("/predict/checkout", {
          method: "POST",
          body: formData,
          headers: {
            "X-Requested-With": "XMLHttpRequest"
          }
        });

        if (res.ok) {
          const data = await res.json();
          if (data && data.status === "success") {
            // Update credentials
            checkoutBankVal.innerText = data.bank_name || "MB Bank";
            checkoutAccountVal.innerText = data.bank_account || "";
            checkoutHolderVal.innerText = data.account_name || "";
            
            // Format VND
            if (data.amount_vnd) {
              const formattedVnd = lang === "en" 
                ? parseFloat(data.amount_vnd).toLocaleString("en-US") + " VND" 
                : parseFloat(data.amount_vnd).toLocaleString("en-US").replace(/,/g, ".") + "Ã„â€˜";
              checkoutAmountVal.innerText = formattedVnd;
              checkoutAmountRawVal.innerText = parseInt(data.amount_vnd);
            }
            
            checkoutMemoVal.innerText = data.add_info || "";
            confirmOrderId.value = data.order_id || "";

            // Load QR Image
            if (data.qr_url) {
              checkoutQrImg.src = data.qr_url;
              checkoutQrImg.onload = () => {
                if (checkoutQrLoader) checkoutQrLoader.style.display = "none";
              };
            } else {
              if (checkoutQrLoader) checkoutQrLoader.style.display = "none";
            }

            // Start auto checking status
            if (data.order_id) {
              startStatusChecking(data.order_id);
            }
          } else {
            if (typeof window.showToast === "function") {
              window.showToast("error", (lang === "en" ? data.message_en : data.message_vi) || (lang === "en" ? "An error occurred" : "Ã„ÂÃƒÂ£ xÃ¡ÂºÂ£y ra lÃ¡Â»â€”i"));
            }
            hideCheckout();
          }
        } else {
          try {
            const errData = await res.json();
            if (typeof window.showToast === "function") {
              window.showToast("error", lang === "en" ? errData.message_en : errData.message_vi);
            }
          } catch(e) {
            if (typeof window.showToast === "function") {
              window.showToast("error", lang === "en" ? "Failed to create order" : "KhÃƒÂ´ng thÃ¡Â»Æ’ tÃ¡ÂºÂ¡o hÃƒÂ³a Ã„â€˜Ã†Â¡n");
            }
          }
          hideCheckout();
        }
      } catch (err) {
        console.error("Checkout AJAX failed:", err);
        if (typeof window.showToast === "function") {
          window.showToast("error", lang === "en" ? "A system error occurred" : "Ã„ÂÃƒÂ£ xÃ¡ÂºÂ£y ra lÃ¡Â»â€”i hÃ¡Â»â€¡ thÃ¡Â»â€˜ng");
        }
        hideCheckout();
      }
    }

    // --- Action Listeners ---
    document.addEventListener("DOMContentLoaded", () => {
      // Initialize modal elements
      checkoutModal = document.getElementById("checkoutModal");
      checkoutModalContent = checkoutModal ? checkoutModal.querySelector("div") : null;
      checkoutPlanIcon = document.getElementById("checkout-plan-icon");
      checkoutPlanName = document.getElementById("checkout-plan-name");
      checkoutPlanPrice = document.getElementById("checkout-plan-price");
      checkoutPlanDuration = document.getElementById("checkout-plan-duration");
      
      checkoutBankVal = document.getElementById("checkout-bank-val");
      checkoutAccountVal = document.getElementById("checkout-account-val");
      checkoutHolderVal = document.getElementById("checkout-holder-val");
      checkoutAmountVal = document.getElementById("checkout-amount-val");
      checkoutAmountRawVal = document.getElementById("checkout-amount-raw-val");
      checkoutMemoVal = document.getElementById("checkout-memo-val");
      
      checkoutQrImg = document.getElementById("checkout-qr-img");
      checkoutQrLoader = document.getElementById("checkout-qr-loader");
      confirmOrderId = document.getElementById("confirm-order-id");

      const currentLang = document.documentElement.getAttribute("data-user-lang") || "vi";
      updateDynamicPrices(currentLang);
      
      // Pricing buttons click listeners
      document.querySelectorAll("[data-plan-btn]").forEach(btn => {
        btn.addEventListener("click", () => {
          const plan = btn.getAttribute("data-plan-btn");
          selectPlanAndShowCheckout(plan);
        });
      });

      // Banner renew button listener
      const bannerRenew = document.getElementById("bannerRenewBtn");
      if (bannerRenew) {
        bannerRenew.addEventListener("click", () => {
          const plan = bannerRenew.getAttribute("data-renew-plan");
          selectPlanAndShowCheckout(plan);
        });
      }

      // Back action from checkout
      const backBtn = document.getElementById("checkoutBackBtn");
      if (backBtn) {
        backBtn.addEventListener("click", () => {
          hideCheckout();
        });
      }

      // Backdrop click to close modal
      if (checkoutModal) {
        checkoutModal.addEventListener("click", (e) => {
          if (e.target === checkoutModal) {
            hideCheckout();
          }
        });
      }

      const qrFullscreenModal = document.getElementById("qrFullscreenModal");
      if (qrFullscreenModal) {
        qrFullscreenModal.addEventListener("click", (e) => {
          if (e.target === qrFullscreenModal) {
            closeQrFullscreen();
          }
        });
      }

      // Escape key to close modal
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          if (qrFullscreenModal && !qrFullscreenModal.classList.contains("hidden")) {
            closeQrFullscreen();
          } else if (checkoutModal && !checkoutModal.classList.contains("hidden")) {
            hideCheckout();
          }
        }
      });
    });

    // --- Handle site language transitions ---
    document.addEventListener("i18nChanged", () => {
      const newLang = document.documentElement.getAttribute("data-user-lang") || "vi";
      updateDynamicPrices(newLang);
      if (activeSelectedPlan) {
        selectPlanAndShowCheckout(activeSelectedPlan);
      }
    });

  })();
</script>
