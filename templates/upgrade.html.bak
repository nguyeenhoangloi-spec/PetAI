<!DOCTYPE html>

<html
  class="{{'dark'if ui_theme=='dark'else'light'}}{{' i18n-loading'if ui_language=='en'else''}}"
  lang="{{ui_language or'vi'}}"
  data-theme="{{ui_theme or'light'}}"
>
  <head>
  <script>
    // Apply initial sidebar collapse state immediately on load to prevent transition animation
    (function() {
      document.documentElement.classList.add("preload");
      try {
        if (window.innerWidth >= 768) {
          const isCollapsed = localStorage.getItem("sidebar-collapsed") === "true";
          if (isCollapsed) {
            document.documentElement.classList.add("sidebar-collapsed");
          } else {
            document.documentElement.classList.remove("sidebar-collapsed");
          }
        }
      } catch (e) {}
    })();
  </script>
  <style id="early-sidebar-style">
    /* Prevent FOUC (Flash of Unstyled Content) during Tailwind compiler startup */
    html.preload body {
      opacity: 0 !important;
    }
    
    /* Early CSS to prevent F5 flicker before stylesheet loads */
    html.preload .sidebar,
    html.preload main,
    html.preload footer {
      transition: none !important;
    }
    
    /* Stable header styles to prevent navigation bar shifting */
    body>nav .flex.items-center.gap-gutter {
      gap: 12px !important;
    }
    body>nav #menuToggle {
      margin-left: 4px !important;
      margin-right: 0 !important;
      position: relative !important;
    }
    
    /* Stable inner sidebar styles to prevent internal text/layout shifting */
    .sidebar-wrapper {
      display: flex !important;
      flex-direction: column !important;
      height: 100% !important;
      justify-content: space-between !important;
      padding: 16px 10px 12px 10px !important;
      box-sizing: border-box !important;
      gap: 12px !important;
    }
    .sidebar-menu {
      display: flex !important;
      flex-direction: column !important;
      gap: 6px !important;
      flex-grow: 1 !important;
    }
    .sidebar-menu-item {
      display: flex !important;
      align-items: center !important;
      gap: 10px;
      height: 40px !important;
      width: 100% !important;
      padding: 0 10px;
      border-radius: 12px !important;
      box-sizing: border-box !important;
      overflow: hidden !important;
    }
    
    @media (min-width: 768px) {
      .sidebar {
        position: fixed !important;
        top: 64px !important;
        left: 0 !important;
        bottom: 0 !important;
        width: 224px !important;
        height: calc(100vh - 64px) !important;
        z-index: 100 !important;
      }
      
      /* Collapsed state */
      html.sidebar-collapsed .sidebar {
        transform: none !important;
        opacity: 1 !important;
        visibility: visible !important;
        width: 72px !important;
      }
      html.sidebar-collapsed main,
      html.sidebar-collapsed footer {
        margin-left: 72px !important;
        width: calc(100% - 72px) !important;
      }
      
      /* Expanded state (default) */
      html:not(.sidebar-collapsed) .sidebar {
        transform: none !important;
        opacity: 1 !important;
        visibility: visible !important;
        width: 224px !important;
      }
      html:not(.sidebar-collapsed) main,
      html:not(.sidebar-collapsed) footer {
        margin-left: 224px !important;
        width: calc(100% - 224px) !important;
      }
      
      /* Force single-column grid immediately for main container on both states */
      html main {
        grid-template-columns: 1fr !important;
        gap: 0 !important;
      }
    }
    
    @media (max-width: 767px) {
      .sidebar {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        height: 100vh !important;
        width: 224px !important;
        transform: translateX(-100%) !important;
        z-index: 1000 !important;
      }
      .sidebar.active {
        transform: translateX(0) !important;
      }
    }
  </style>
    <script>
      (function () {
        var savedLang = "vi";
        try {
          var match = document.cookie.match(new RegExp('(^| )siteLanguage=([^;]+)'));
          if (match) {
            savedLang = match[2];
          } else {
            savedLang = localStorage.getItem("siteLanguage") || "vi";
          }
        } catch (e) {}
        document.documentElement.setAttribute("data-user-lang", savedLang);
        if (savedLang === "en") {
          document.documentElement.classList.add("i18n-loading");
        }
      })();
    </script>
    <style>
      html.i18n-loading body {
        visibility: hidden !important;
      }
    </style>
    <noscript>
      <style>
        html.i18n-loading body {
          visibility: visible !important;
        }
      </style>
    </noscript>
    <meta charset="utf-8">
      <meta content="width=device-width, initial-scale=1.0" name="viewport">
      <meta name="csrf-token" content="{{ csrf_token() }}">
      <script>
        (function () {
          const root = document.documentElement;
          const themeStorageKey =
            "{{ 'theme:' ~ session.get('user_id') if session.get('user_id') else '' }}";
          const serverTheme = "{{ ui_theme or 'light' }}";
          if (themeStorageKey) {
            try {
              localStorage.setItem(themeStorageKey, serverTheme);
            } catch (e) {}
          }
          const storedTheme = (function () {
            if (!themeStorageKey) return null;
            try {
              return localStorage.getItem(themeStorageKey);
            } catch (e) {
              return null;
            }
          })();
          const preferredTheme = storedTheme || serverTheme;

          function resolveTheme(theme) {
            if (theme !== "auto") return theme;
            try {
              return window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
            } catch (e) {
              return "light";
            }
          }

          function applyTheme(theme) {
            const resolved = resolveTheme(theme);
            root.classList.toggle("dark", resolved === "dark");
            root.classList.toggle("light", resolved !== "dark");
            root.setAttribute("data-theme", resolved);
          }

          applyTheme(preferredTheme);

          if (preferredTheme === "auto") {
            try {
              const mql = window.matchMedia("(prefers-color-scheme: dark)");
              const handler = function () {
                applyTheme("auto");
              };
              if (mql.addEventListener) {
                mql.addEventListener("change", handler);
              } else if (mql.addListener) {
                mql.addListener(handler);
              }
            } catch (e) {}
          }

          try {
            const isCollapsed =
              localStorage.getItem("sidebar-collapsed") === "true";
            if (isCollapsed && window.innerWidth >= 768) {
              root.classList.add("sidebar-collapsed");
            }
          } catch (e) {}
        })();
    </script>
    <title data-i18n="upgradePageTitle">{{ 'Upgrade' if ui_language == 'en' else 'NÃƒÂ¢ng cÃ¡ÂºÂ¥p' }} - {{ get_config('site_name', 'PetAI') }}</title>
