                <div id="modalBankContent" class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out mt-2.5 space-y-2.5">
                  <div class="bg-slate-50 dark:bg-slate-900/60 p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 flex justify-between items-center text-[11px]">
                    <div>
                      <span class="text-slate-400 dark:text-slate-500 block text-[9px]" data-i18n="bankLabel">NgÃƒÂ¢n hÃƒÂ ng</span>
                      <strong class="text-slate-700 dark:text-slate-200" id="checkout-bank-val">MB Bank</strong>
                    </div>
                    <button type="button" class="text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300 text-xs flex items-center gap-0.5" onclick="copyText('checkout-bank-val')">
                      <span class="material-symbols-outlined text-[13px]">content_copy</span>
