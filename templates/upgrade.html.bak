              </div>
              <button type="button" onclick="closeCheckoutModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors flex items-center justify-center w-8 h-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800" aria-label="Close">
                <span class="material-symbols-outlined text-[20px]">close</span>
              </button>
