<script>
  (function() {
    function formatVND(val, suffix) {
      if (!val) return "";
      const num = parseFloat(String(val).replace(/[^0-9]/g, ''));
      if (isNaN(num)) return val + suffix;
      return num.toLocaleString('en-US').replace(/,/g, '.') + suffix;
    }
    function formatVND_EN(val, suffix) {
      if (!val) return "";
      const num = parseFloat(String(val).replace(/[^0-9]/g, ''));
      if (isNaN(num)) return val + suffix;
      return num.toLocaleString('en-US') + suffix;
    }
    
