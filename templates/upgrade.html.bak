        <!-- Ã¢â€â‚¬Ã¢â€â‚¬ Checkout Modal (Popup) Ã¢â€â‚¬Ã¢â€â‚¬ -->
        <div id="checkoutModal" class="fixed inset-0 z-[3000] hidden items-center justify-center p-4 overflow-hidden overscroll-none transition-all duration-300 opacity-0" role="dialog" aria-modal="true">
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-2xl w-full shadow-2xl transform scale-95 transition-all duration-300 flex flex-col max-h-[80vh] overflow-hidden relative outline-none">
            
            <!-- Modal Header -->
