        optPro: "ChuyÃƒÂªn nghiÃ¡Â»â€¡p (Pro) Ã¢â‚¬â€ " + formatVND("{{ get_config('plan_pro_price', '5000') }}", "Ã„â€˜") + " / {{ get_config('plan_pro_days', '30') }} ngÃƒÂ y / {{ get_config('plan_pro_scans', '200') }} lÃ†Â°Ã¡Â»Â£t",
